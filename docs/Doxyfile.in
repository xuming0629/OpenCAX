PROJECT_NAME           = "OpenCAX"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "OpenCAX C++ API Documentation"

OUTPUT_DIRECTORY       = "@OPEN_CAX_DOC_OUTPUT_DIR@"

INPUT                  = "@OPEN_CAX_DOC_INPUT_DIR@"
RECURSIVE              = YES

FILE_PATTERNS          = *.h *.hpp *.hh

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO

HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
UML_LOOK               = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
REFERENCES_RELATION    = NO
REFERENCED_BY_RELATION = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES

PREDEFINED             = OpenCAX_API=